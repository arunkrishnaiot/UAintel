# Copy this file to .env and fill in your values
# For local development only — never commit .env to GitHub

# Database
# Local: leave as default SQLite
# Production: get this from Render.com dashboard
DATABASE_URL=sqlite:///./uaintel.db

# App
APP_ENV=development
SECRET_KEY=change-this-to-something-random-in-production

# Rate limiting (requests per minute per IP)
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_REPORT=10

# Auto-update databases every N days
DB_AUTO_UPDATE_DAYS=7
